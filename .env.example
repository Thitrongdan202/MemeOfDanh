# ==========================================
# MEMEOF DANH — DIGITAL MEME MUSEUM CONFIG
# ==========================================

# Thư mục chứa memes gốc (ảnh / video). Mặc định là ./memes trong thư mục dự án.
# Có thể đổi thành đường dẫn tuyệt đối trên Windows, ví dụ: C:\Users\thitr\Downloads\Danh\memes
MEMES_DIR=./memes

# Thư mục lưu trữ manifest dữ liệu và cache
MEME_DATA_DIR=./data

# Cấu hình AI Meme Curator
# Lựa chọn: 'gemini' | 'openai' | 'offline'
# Nếu không cung cấp API key, hệ thống sẽ tự động dùng chế độ 'offline' thông minh
# mà không làm gián đoạn hay crash website!
AI_PROVIDER=gemini
AI_API_KEY=
AI_MODEL=gemini-1.5-flash

# Tinh chỉnh độ hóm hỉnh và sáng tạo của AI (0.0 - 1.0)
AI_TEMPERATURE=0.8

# Port chạy server (mặc định 3000)
PORT=3000
HOST=localhost
