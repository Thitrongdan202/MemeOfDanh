# ==========================================
# MEMEOF DANH — DIGITAL MEME MUSEUM CONFIG
# ==========================================

# Thư mục chứa memes gốc (ảnh / video). Mặc định là ./memes trong thư mục dự án.
# Có thể đổi thành đường dẫn tuyệt đối trên Windows, ví dụ: C:\Users\thitr\Downloads\Danh\memes
MEMES_DIR=./memes

# Thư mục lưu trữ manifest dữ liệu và cache
MEME_DATA_DIR=./data

# Cấu hình AI Meme Curator V3.0
# Provider ưu tiên:
# 1. 'gemini'  : Google Gemini Developer API (Hỗ trợ native vision + video understanding)
#    - Model mặc định: gemini-3.8-flash (hoặc gemini-2.5-flash / gemini-2.0-flash)
#    - Đăng ký API Key miễn phí tại: https://aistudio.google.com/app/apikey
# 2. 'ollama'  : Local AI qua Ollama (Model: qwen3-vl hoặc qwen2.5-vl:7b)
#    - Chạy trên máy nội bộ: http://localhost:11434 (yêu cầu cài trước Ollama)
# 3. 'offline' : Bộ giám tuyển Offline Smart Curator v3.0 tạo tên hài hước không cần mạng/key
AI_PROVIDER=gemini
AI_MODEL=gemini-3.8-flash
AI_API_KEY=

# Cấu hình Ollama local (nếu dùng AI_PROVIDER=ollama)
OLLAMA_HOST=http://localhost:11434

# Port chạy server (mặc định 3000)
PORT=3000
HOST=localhost
