{
  "name": "danhmus-server",
  "version": "1.0.0",
  "private": true,
  "description": "Danh'Mus API Server — Express backend serving media, manifest and AI pipeline",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc --project tsconfig.json",
    "sync": "tsx src/scripts/sync.ts",
    "sync:dry": "tsx src/scripts/sync.ts --dry-run",
    "compare": "tsx src/scripts/preview-comparison.ts",
    "test:pipeline": "tsx src/scripts/test-grounding-pipeline.ts"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@google/generative-ai": "^0.21.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "morgan": "^1.10.0",
    "sharp": "^0.33.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
